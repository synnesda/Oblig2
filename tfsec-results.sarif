              }
            }
          ]
        },
        {
          "ruleId": "azure-storage-use-secure-tls-policy",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Storage account uses an insecure TLS version."
          },
          "locations": [
